{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/bombwcc.ansi",
    "padding": {
      "top": 1,
      "right": 2
    }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "users",
    "break",
    "shell",
    "terminal",
    "packages",
    "processes",
    "break",
    "display",
    "break",
    "cpu",
    "gpu",
    "loadavg",
    "memory",
    "swap",
    "disk",
    "break",
    "bluetooth",
    "wifi",
    "battery",
    "poweradapter",
    "locale",
    "break",

    {
      "type": "command",
      "key": "󰊤 GitHub",
      "text": "curl -s 'https://github-pulse-topaz.vercel.app/api/u/bombwcc' | jq -r '\"\\(.state | ascii_upcase) · \\(.bpm) BPM · \\(.weekly) this week\"'"
    },

    {
      "type": "weather",
      "key": "Weather",
      "location": "Chongqing",
      "timeout": 3000,
      "outputFormat": "%c+%t"
    },
    {
    "type": "datetime",
    "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty} {timezone-name}"
    },
    "break",
    "colors"
  ]
}
