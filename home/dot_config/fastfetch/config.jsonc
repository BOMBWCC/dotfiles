{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/bombwcc.ansi",
    "padding": {
      "top": 1,
      "right": 2
    }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "users",
    "break",
    "shell",
    "terminal",
    "packages",
    "processes",
    "break",
    "display",
    "break",
    "cpu",
    "gpu",
    "loadavg",
    "memory",
    "swap",
    "disk",
    "break",
    "bluetooth",
    "wifi",
    "battery",
    "poweradapter",
    "locale",
    "break",
    {
    "type": "datetime",
    "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty} {timezone-name}"
    },
    "break",
    "colors"
  ]
}
